{
  "compilerOptions": {
    "module": "NodeNext",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2020",
    "lib": [
      "DOM",
      "ES2020"
    ],
    "noImplicitAny": true,
    "skipLibCheck": true,
    "moduleResolution": "NodeNext",
    "declaration": true,
    "sourceMap": false,
    "outDir": "dist"
  },
  "include": [
    "src/**/*"
  ]
}
