{
  "name": "packetgram",
  "version": "0.1.0",
  "description": "Read and write packets using buffers",
  "type": "module",
  "main": "dist/packet.js",
  "types": "dist/packet.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/packet.d.ts",
        "default": "./dist/packet.js"
      },
      "require": {
        "types": "./dist/packet.d.cts",
        "default": "./dist/packet.umd.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "test": "npm run test:node && npm run test:browser && npm run test:package",
    "pretest:browser": "npm run build",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:node": "vitest run",
    "test:package": "tsc -p test/package && node test/package/out/consumer.cjs && node test/package/out/consumer.mjs",
    "build": "vite build && tsc --emitDeclarationOnly && node scripts/build-cts.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "buffer",
    "packet",
    "endian"
  ],
  "author": {
    "email": "git@tylerstewart.ca",
    "name": "Tyler Stewart",
    "url": "https://tylerstewart.ca"
  },
  "license": "Unlicense",
  "repository": {
    "type": "git",
    "url": "https://github.com/trs/packetgram"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "@types/puppeteer": "^7.0.4",
    "puppeteer": "^24.34.0",
    "semantic-release": "^25.0.2",
    "typescript": "^5.9.3",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  },
  "packageManager": "yarn@4.19.0"
}
